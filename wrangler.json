{
	"compatibility_date": "2026-04-24",
	"compatibility_flags": [
		"global_fetch_strictly_public",
		"nodejs_compat"
	],
	"name": "dulichladakh-web",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"workers_dev": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "ladakh_d1",
			"database_name": "ladakh_d1",
			"database_id": "385534ff-81f2-48e1-b14e-44e558be9bc8"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "ladakh-media"
		}
	],
	"vars": {
		"PUBLIC_CDN_BASE": "https://media.dulichladakh.com",
		"ROBOTS_INDEX": "true"
	}
}

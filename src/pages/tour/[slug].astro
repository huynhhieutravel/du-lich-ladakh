---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import '../../styles/tour-landing.css';

export const prerender = false;

const { slug } = Astro.params;
const db = (env as any)?.ladakh_d1;

if (!db || !slug) {
  return Astro.redirect('/tour');
}

const tour = await db.prepare("SELECT * FROM Tour WHERE slug = ? AND status != 'trash'").bind(slug).first<any>();

if (!tour) {
  return new Response("Tour không tồn tại hoặc đã tạm dừng nhận khách", { status: 404 });
}

// Format Price
let formattedPrice = tour.price_text || '';
if (!formattedPrice && tour.price) {
  formattedPrice = new Intl.NumberFormat('vi-VN').format(tour.price) + ' VNĐ';
}
if (!formattedPrice) {
  formattedPrice = 'Liên hệ';
}

// Format Duration
let formattedDuration = tour.days || '';
if (!formattedDuration && tour.durationDays) {
  formattedDuration = `${tour.durationDays} Ngày ${tour.durationNights || 0} Đêm`;
}
if (!formattedDuration) {
  formattedDuration = '7 Ngày 6 Đêm';
}

const coverImage = tour.featuredImage || 'https://media.dulichladakh.com/uploads/mountain-view-room-kashmir-himalaya.webp';
const pageTitle = tour.seoTitle || `${tour.title} | Du Lịch Ladakh Trọn Gói`;
const pageDesc = tour.seoDescription || tour.excerpt || tour.overview || `Khám phá hành trình ${tour.title} cùng đội ngũ chuyên gia bản địa Himalaya. Lịch trình chi tiết, giá minh bạch.`;
const ogImg = tour.ogImage || coverImage;

// Content HTML
let contentHtml = tour.content || '';
const customCss = tour.css_content || '';

// Fallback: If content is empty, build standard Golden Order layout on the fly
if (!contentHtml || contentHtml.trim().length < 20) {
  let highlightsArr: string[] = [];
  try { highlightsArr = typeof tour.highlights === 'string' ? JSON.parse(tour.highlights) : (tour.highlights || []); } catch(e){}

  let itineraryArr: { day: number; title: string; content: string }[] = [];
  try { itineraryArr = typeof tour.itinerary === 'string' ? JSON.parse(tour.itinerary) : (tour.itinerary || []); } catch(e){}

  let hlHtml = '';
  highlightsArr.forEach(hl => {
    if (hl && hl.trim()) {
      hlHtml += `\n          <div class="highlight-list-item">
            <svg class="highlight-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <span class="highlight-text">${hl.trim()}</span>
          </div>`;
    }
  });

  let itHtml = '';
  itineraryArr.forEach((it, idx) => {
    itHtml += `\n            <details class="premium-itinerary-item" ${idx === 0 ? 'open' : ''}>
              <summary class="premium-itinerary-summary">
                <div class="itinerary-toggle-icon">+</div>
                <span>Ngày ${it.day || idx + 1}: ${it.title || ''}</span>
              </summary>
              <div class="premium-itinerary-content custom-blog-prose max-w-none">
                <p style="margin-bottom:14px">${it.content || ''}</p>
              </div>
            </details>`;
  });

  contentHtml = `<div class="elementor-tour-wrapper custom-tour-layout max-w-[1200px] mx-auto px-4 py-8 lg:py-12">
  <nav class="flex text-sm text-gray-500 mb-8" aria-label="Breadcrumb">
    <a href="/" class="hover:text-slate-800">Trang chủ</a>
    <span class="mx-2">/</span>
    <a href="/tour" class="hover:text-slate-800">Tour Ladakh</a>
    <span class="mx-2">/</span>
    <span class="text-slate-800 font-medium ml-1">${tour.title}</span>
  </nav>

  <div class="mobile-image">
    <div class="rounded-2xl overflow-hidden shadow-sm border border-gray-100 aspect-[16/9] bg-gray-100 relative">
      <img src="{{TOUR_FEATURED_IMAGE}}" alt="{{TOUR_TITLE}}" class="w-full h-full object-cover absolute inset-0" width="800" height="450" fetchpriority="high" />
    </div>
  </div>

  <div class="tour-grid-container">
    <div class="tour-main-col">
      <div class="desktop-image">
        <div class="rounded-2xl overflow-hidden shadow-sm border border-gray-100 aspect-[16/9] bg-gray-100 relative">
          <img src="{{TOUR_FEATURED_IMAGE}}" alt="{{TOUR_TITLE}}" class="w-full h-full object-cover absolute inset-0" width="800" height="450" fetchpriority="high" />
        </div>
      </div>
      
      <div class="premium-cta-bar">
        <div class="cta-title">Tư vấn lịch trình chi tiết &amp; Báo giá ưu đãi</div>
        <div class="cta-links">
          <a href="https://zalo.me/0909000000" target="_blank" class="social-btn zalo-btn">
            <span>Tư vấn Zalo</span>
          </a>
          <a href="https://m.me/dulichladakh" target="_blank" class="social-btn messenger-btn">
            <span>Messenger</span>
          </a>
          <a href="#booking-form" class="social-btn form-btn">
            <span>Đăng ký tư vấn</span>
          </a>
        </div>
      </div>

      ${hlHtml ? `<section class="tour-highlights-section mb-10 mt-10">
        <h2 class="text-2xl font-bold text-slate-800 mb-6">Trải nghiệm hấp dẫn của chuyến đi</h2>
        <div class="highlights-list">${hlHtml}
        </div>
      </section>` : ''}

      <div class="premium-qr-box">
        <div class="qr-wrapper">
          <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=https://dulichladakh.com/tour/${tour.slug}&margin=0" alt="QR Link" width="96" height="96" loading="lazy" />
        </div>
        <div class="qr-text">
          <div class="qr-title">Quét mã QR hành trình</div>
          <div class="qr-desc">Lưu và chia sẻ lịch trình trên thiết bị di động của bạn mọi lúc, mọi nơi.</div>
        </div>
      </div>

      <div class="premium-quote-box">
        <svg class="quote-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
        <p class="quote-text">Ladakh không chỉ là một chuyến du lịch, đó là hành trình thanh lọc tâm hồn giữa miền đất Phật linh thiêng bên rặng Himalaya hùng vĩ.</p>
      </div>

      <section class="tour-accommodation-section mb-12 mt-10">
        <h2 class="text-2xl font-bold text-slate-800 mb-6">Nơi ở của bạn</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 bg-slate-50 border border-slate-100 rounded-2xl flex items-start gap-4">
            <span class="text-2xl">🏨</span>
            <div>
              <div class="font-bold text-slate-800 text-sm">Khách sạn tiêu chuẩn 3 - 4 sao tại Leh</div>
              <div class="text-xs text-gray-500 mt-1">Phòng có hệ thống sưởi ấm, nước nóng 24/7 và trang bị bình oxy y tế hỗ trợ thích nghi độ cao.</div>
            </div>
          </div>
          <div class="p-5 bg-slate-50 border border-slate-100 rounded-2xl flex items-start gap-4">
            <span class="text-2xl">⛺</span>
            <div>
              <div class="font-bold text-slate-800 text-sm">Lều Glamping cao cấp tại Hồ Pangong & Thung lũng Nubra</div>
              <div class="text-xs text-gray-500 mt-1">Trải nghiệm cắm trại ngắm dải ngân hà kỳ ảo, chăn nệm ấm áp và vệ sinh khép kín sạch sẽ.</div>
            </div>
          </div>
        </div>
      </section>

      ${itHtml ? `<section class="tour-itinerary-section mb-12 mt-12">
        <h2 class="text-2xl font-bold text-slate-800 mb-6">Lịch trình chi tiết từng ngày</h2>
        <div class="tour-itinerary">
          <div class="flex flex-col gap-4">${itHtml}
          </div>
        </div>
      </section>` : ''}

      <section class="tour-schedule-section mb-12 mt-10">
        <h2 class="text-2xl font-bold text-slate-800 mb-6">Lịch khởi hành &amp; Bảng giá</h2>
        <div class="tour-schedule-table">
          <table style="width:100%;border-collapse:collapse;margin:8px 0 16px 0;font-size:15px">
            <thead>
              <tr>
                <th style="padding:12px 16px;border-bottom:2px solid #e2e8f0;text-align:left;font-weight:600">Đợt khởi hành</th>
                <th style="padding:12px 16px;border-bottom:2px solid #e2e8f0;text-align:left;font-weight:600">Thời gian</th>
                <th style="padding:12px 16px;border-bottom:2px solid #e2e8f0;text-align:left;font-weight:600">Giá trọn gói</th>
                <th style="padding:12px 16px;border-bottom:2px solid #e2e8f0;text-align:left;font-weight:600">Tình trạng</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="padding:12px 16px;border-bottom:1px solid #e2e8f0;color:#475569">Mùa Xuân Hoa Mơ (Tháng 4 - 5)</td>
                <td style="padding:12px 16px;border-bottom:1px solid #e2e8f0;color:#475569">{{TOUR_DURATION}}</td>
                <td style="padding:12px 16px;border-bottom:1px solid #e2e8f0;font-weight:700;color:#d97706">{{TOUR_PRICE_FORMATTED}}</td>
                <td style="padding:12px 16px;border-bottom:1px solid #e2e8f0"><span class="cat-badge published">Nhận chỗ</span></td>
              </tr>
              <tr>
                <td style="padding:12px 16px;border-bottom:1px solid #e2e8f0;color:#475569">Mùa Hè Nắng Ấm (Tháng 6 - 8)</td>
                <td style="padding:12px 16px;border-bottom:1px solid #e2e8f0;color:#475569">{{TOUR_DURATION}}</td>
                <td style="padding:12px 16px;border-bottom:1px solid #e2e8f0;font-weight:700;color:#d97706">{{TOUR_PRICE_FORMATTED}}</td>
                <td style="padding:12px 16px;border-bottom:1px solid #e2e8f0"><span class="cat-badge published">Nhận chỗ</span></td>
              </tr>
              <tr>
                <td style="padding:12px 16px;border-bottom:1px solid #e2e8f0;color:#475569">Mùa Thu Lá Vàng (Tháng 9 - 10)</td>
                <td style="padding:12px 16px;border-bottom:1px solid #e2e8f0;color:#475569">{{TOUR_DURATION}}</td>
                <td style="padding:12px 16px;border-bottom:1px solid #e2e8f0;font-weight:700;color:#d97706">{{TOUR_PRICE_FORMATTED}}</td>
                <td style="padding:12px 16px;border-bottom:1px solid #e2e8f0"><span class="cat-badge published">Nhận chỗ</span></td>
              </tr>
            </tbody>
          </table>
          <p style="font-size:13px;color:#64748b;font-style:italic;margin-top:8px">* Nhận thiết kế đoàn riêng theo ngày khởi hành mong muốn của quý khách từ 4 người trở lên.</p>
        </div>
      </section>

      <section class="tour-faq-wrapper mb-12 mt-10">
        <h2 class="text-2xl font-bold text-slate-800 mb-6">Thông Tin Thêm Về Chuyến Đi</h2>
        <div class="flex flex-col gap-4">
          <details open class="premium-itinerary-item">
            <summary class="premium-itinerary-summary" style="background:#f8fafc">
              <div class="itinerary-toggle-icon">+</div>
              <span class="font-bold text-slate-800">Dịch vụ Bao Gồm</span>
            </summary>
            <div class="premium-itinerary-content custom-blog-prose max-w-none">
              <p style="margin-bottom:14px">${tour.included || 'Xe SUV chuyên dụng suốt tuyến; Khách sạn 3-4 sao có sưởi ấm; Các bữa ăn; Giấy phép biên giới ILP; Hướng dẫn viên & bình oxy y tế.'}</p>
            </div>
          </details>
          <details class="premium-itinerary-item">
            <summary class="premium-itinerary-summary" style="background:#f8fafc">
              <div class="itinerary-toggle-icon">+</div>
              <span class="font-bold text-slate-800">Không Bao Gồm</span>
            </summary>
            <div class="premium-itinerary-content custom-blog-prose max-w-none">
              <p style="margin-bottom:14px">${tour.excluded || 'Vé máy bay quốc tế & nội địa; Visa Ấn Độ; Tiền tip lái xe; Chi phí cá nhân.'}</p>
            </div>
          </details>
        </div>
      </section>

      <section class="tour-reviews-section mb-12">
        <h2 class="text-2xl font-bold text-slate-800 mb-6">Hình ảnh hành trình thực tế</h2>
        <div class="grid-fit-masonry coguu-gallery-cols-2 mb-6">
          <div class="feature-box">
            <img src="https://media.dulichladakh.com/uploads/mountain-view-room-kashmir-himalaya.webp" alt="Khách sạn view núi tuyết" class="feature-image" loading="lazy" />
            <div class="feature-overlay"></div>
          </div>
          <div class="feature-box">
            <img src="https://media.dulichladakh.com/uploads/traveler-relaxing-at-kashmir-mountain-resort.webp" alt="Du khách tại Kashmir" class="feature-image" loading="lazy" />
            <div class="feature-overlay"></div>
          </div>
          <div class="feature-box">
            <img src="https://media.dulichladakh.com/uploads/kashmir-traveler-at-vtc-dras-kargil.webp" alt="Đoàn khách tại đèo Kargil" class="feature-image" loading="lazy" />
            <div class="feature-overlay"></div>
          </div>
          <div class="feature-box">
            <img src="https://media.dulichladakh.com/uploads/young-monks-monastery-ladakh-india.webp" alt="Tu viện Phật giáo Ladakh" class="feature-image" loading="lazy" />
            <div class="feature-overlay"></div>
          </div>
        </div>
      </section>
    </div>

    <div class="tour-sidebar-col">
      <div class="sticky top-[100px] flex flex-col gap-8">
        <div>
          <h1 class="text-3xl md:text-4xl font-extrabold text-slate-800 leading-[1.2] mt-0 tracking-tight" style="margin-bottom: 24px;">{{TOUR_TITLE}}</h1>
          <div class="text-gray-600 text-[16px] leading-relaxed font-normal custom-blog-prose space-y-4">
            <p style="margin-bottom:14px">${tour.overview || ''}</p>
          </div>
        </div>

        <div class="sticky-price-card">
          <div class="service-grid">
            <div class="service-item">
              <div class="service-icon">
                <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              </div>
              <div class="service-title">Dịch vụ</div>
              <div class="service-sub">Trọn gói</div>
            </div>
            <div class="service-item">
              <div class="service-icon">
                <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              </div>
              <div class="service-title">Thời gian</div>
              <div class="service-sub">{{TOUR_DURATION}}</div>
            </div>
          </div>
          
          <div style="margin-bottom: 24px;">
            <div class="price-label">Giá Trọn Gói Từ</div>
            <div class="price-amount">{{TOUR_PRICE_FORMATTED}}</div>
          </div>

          <div class="action-buttons">
            <a href="https://zalo.me/0909000000" target="_blank" class="btn-primary btn-zalo">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M21.5 12.3c0-4.9-4.3-8.8-9.5-8.8s-9.5 3.9-9.5 8.8c0 4.1 2.9 7.6 6.8 8.6.2.1.5.3.4.6-.1.4-.4 1.3-.5 1.8-.1.3-.2.4.1.6.3.1.5-.1.8-.3 1.3-.8 2.8-1.8 3.3-2.1.3-.2.6-.2.9-.1 2.3.8 5-.4 6.3-2.3.8-1.5 1-4.1.9-6.8z"/></svg>
              Tư vấn Zalo
            </a>
            <a href="https://m.me/dulichladakh" target="_blank" class="btn-primary btn-msg">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.145 2 11.258c0 2.923 1.472 5.518 3.753 7.185v3.42l3.41-1.86a10.871 10.871 0 0 0 2.837.382c5.523 0 10-4.145 10-9.258C22 6.145 17.523 2 12 2zm1.096 12.443-2.823-3.003-5.514 3.003 6.068-6.438 2.89 3.002 5.445-3.002-6.066 6.438z"/></svg>
              Messenger
            </a>
          </div>
          
          <div class="mt-4 border-t border-gray-100 pt-4 flex flex-col gap-3">
            <div class="flex items-center gap-3 text-sm text-gray-600">
              <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-green-500"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              Khởi hành định kỳ hàng tháng
            </div>
            <div class="flex items-center gap-3 text-sm text-gray-600">
              <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-green-500"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              Đoàn riêng từ 4 khách theo yêu cầu
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>`;
}

// Replace dynamic template placeholders
if (contentHtml) {
  contentHtml = contentHtml.replace(/{{TOUR_PRICE_FORMATTED}}/g, formattedPrice);
  contentHtml = contentHtml.replace(/{{TOUR_DURATION}}/g, formattedDuration);
  contentHtml = contentHtml.replace(/{{TOUR_FEATURED_IMAGE}}/g, coverImage);
  contentHtml = contentHtml.replace(/{{TOUR_TITLE}}/g, tour.title || '');
}

// Schema structured data
const origin = Astro.url.origin;
const canonicalUrl = `https://dulichladakh.com/tour/${tour.slug}`;
---

<BaseLayout 
  title={pageTitle}
  description={pageDesc}
  ogImage={ogImg}
  canonicalUrl={canonicalUrl}
>
  {customCss && (
    <style set:html={customCss}></style>
  )}

  <main class="bg-white min-h-screen text-slate-800">
    <div set:html={contentHtml}></div>
  </main>
</BaseLayout>

---
import AdminLayout from '@/layouts/AdminLayout.astro';
import PostEditorWrapper from '@/components/admin/PostEditorWrapper.tsx';

const id = Astro.url.searchParams.get('id');
---

<AdminLayout title={id ? "Edit Post" : "New Post"} activeMenu="posts" activeSubmenu="new" hideSidebar={true}>
  <PostEditorWrapper client:only="react" initialPostId={id} />
</AdminLayout>

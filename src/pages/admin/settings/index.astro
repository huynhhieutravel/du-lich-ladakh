---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';

export const prerender = false;

const db = (env as any)?.ladakh_d1;
let settings: Record<string, any> = {};

if (db) {
  try {
    const { results } = await db.prepare("SELECT * FROM SiteSetting").all();
    (results || []).forEach((row: any) => {
      try {
        settings[row.key] = typeof row.value === 'string' ? JSON.parse(row.value) : row.value;
      } catch (e) {
        settings[row.key] = row.value;
      }
    });
  } catch (e) {
    console.error('Failed to fetch settings', e);
  }
}

// Defaults
const siteTitle = settings.site_title || 'Du Lịch Ladakh - Cẩm Nang & Tour Khám Phá Tiểu Tây Tạng';
const siteDesc = settings.site_description || 'Chuyên trang cẩm nang du lịch Ladakh tự túc và tour du lịch Himalaya cao cấp.';
const hotline = settings.hotline || '0909 123 456';
const zalo = settings.zalo || '0909 123 456';
const email = settings.email || 'contact@dulichladakh.com';
const address = settings.address || 'Leh Market, Ladakh & Đại diện tư vấn FIT TOUR Việt Nam';
const facebookUrl = settings.facebook_url || 'https://facebook.com';
const youtubeUrl = settings.youtube_url || '';
const gaId = settings.google_analytics_id || '';
const announcement = settings.announcement_bar || 'Mở cổng đăng ký Tour Ladakh mùa hè 2026 - Giữ chỗ sớm nhận ưu đãi hấp dẫn!';
---

<AdminLayout title="Cài Đặt Hệ Thống" activeMenu="settings">
  <div class="max-w-4xl mx-auto space-y-6 pb-20">
    <!-- HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
      <div>
        <h1 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
          Cài Đặt Website
        </h1>
        <p class="text-xs text-slate-500 mt-1">
          Cấu hình thông tin thương hiệu, hotline tư vấn, mạng xã hội và mã đo lường
        </p>
      </div>

      <button
        id="save-settings-btn"
        type="button"
        class="px-5 py-2.5 rounded-lg bg-amber-500 hover:bg-amber-600 text-white font-semibold text-xs inline-flex items-center gap-2 shadow-sm transition-all cursor-pointer"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
        <span>Lưu Cấu Hình</span>
      </button>
    </div>

    <!-- NOTIFICATION ALERT -->
    <div id="settings-alert" class="hidden p-4 rounded-lg text-xs flex items-center justify-between border"></div>

    <form id="settings-form" class="space-y-6">
      <!-- THÔNG TIN CHUNG & SEO -->
      <div class="bg-white border border-slate-200 shadow-sm rounded-xl p-6 space-y-4">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 border-b border-slate-100 pb-2.5">
          Thông Tin Chung & Thương Hiệu
        </h2>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">
            Tiêu Đề Website (Site Title)
          </label>
          <input
            type="text"
            name="site_title"
            value={siteTitle}
            class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg text-xs text-slate-800 outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition-all"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">
            Mô Tả Trang Web (Meta Description Mặc Định)
          </label>
          <textarea
            name="site_description"
            rows={2}
            class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg text-xs text-slate-800 outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 leading-relaxed transition-all"
          >{siteDesc}</textarea>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">
            Thanh Thông Báo Nổi Bật (Announcement Bar Đầu Trang)
          </label>
          <input
            type="text"
            name="announcement_bar"
            value={announcement}
            class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg text-xs text-amber-700 font-medium outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition-all"
          />
        </div>
      </div>

      <!-- LIÊN HỆ & HOTLINE -->
      <div class="bg-white border border-slate-200 shadow-sm rounded-xl p-6 space-y-4">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 border-b border-slate-100 pb-2.5">
          Đường Dây Nóng & Tư Vấn
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1.5">Hotline Tư Vấn</label>
            <input
              type="text"
              name="hotline"
              value={hotline}
              class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg text-xs text-slate-800 outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 font-mono transition-all"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1.5">Số Zalo CSKH</label>
            <input
              type="text"
              name="zalo"
              value={zalo}
              class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg text-xs text-slate-800 outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 font-mono transition-all"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1.5">Email Hỗ Trợ</label>
            <input
              type="email"
              name="email"
              value={email}
              class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg text-xs text-slate-800 outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 font-mono transition-all"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1.5">Địa Chỉ Văn Phòng</label>
            <input
              type="text"
              name="address"
              value={address}
              class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg text-xs text-slate-800 outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition-all"
            />
          </div>
        </div>
      </div>

      <!-- MẠNG XÃ HỘI & MÃ ĐO LƯỜNG -->
      <div class="bg-white border border-slate-200 shadow-sm rounded-xl p-6 space-y-4">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 border-b border-slate-100 pb-2.5">
          Mạng Xã Hội & Phân Tích
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1.5">Trang Facebook / Fanpage</label>
            <input
              type="url"
              name="facebook_url"
              value={facebookUrl}
              placeholder="https://facebook.com/..."
              class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg text-xs text-slate-800 outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition-all"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1.5">Kênh YouTube</label>
            <input
              type="url"
              name="youtube_url"
              value={youtubeUrl}
              placeholder="https://youtube.com/@..."
              class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg text-xs text-slate-800 outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition-all"
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">Google Analytics ID (GA4)</label>
          <input
            type="text"
            name="google_analytics_id"
            value={gaId}
            placeholder="G-XXXXXXXXXX"
            class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg text-xs text-slate-800 outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 font-mono transition-all"
          />
        </div>
      </div>
    </form>
  </div>

  <script>
    const saveBtn = document.getElementById('save-settings-btn');
    const form = document.getElementById('settings-form') as HTMLFormElement;
    const alertBox = document.getElementById('settings-alert');

    saveBtn?.addEventListener('click', async () => {
      if (!form) return;
      const formData = new FormData(form);
      const data: Record<string, string> = {};

      formData.forEach((val, key) => {
        data[key] = val.toString().trim();
      });

      if (saveBtn) {
        saveBtn.setAttribute('disabled', 'true');
        saveBtn.classList.add('opacity-50');
      }

      try {
        const res = await fetch('/api/admin/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await res.json();

        if (alertBox) {
          alertBox.classList.remove('hidden');
          if (res.ok && result.success) {
            alertBox.className = 'p-4 rounded-lg text-xs flex items-center justify-between border bg-emerald-50 border-emerald-200 text-emerald-800 font-medium';
            alertBox.innerHTML = '<span>✅ Lưu cấu hình hệ thống thành công!</span>';
          } else {
            alertBox.className = 'p-4 rounded-lg text-xs flex items-center justify-between border bg-rose-50 border-rose-200 text-rose-800 font-medium';
            alertBox.innerHTML = `<span>⚠️ Lỗi: ${result.message || 'Không thể lưu cài đặt'}</span>`;
          }
          setTimeout(() => alertBox.classList.add('hidden'), 5000);
        }
      } catch (err) {
        alert('Lỗi kết nối máy chủ');
      } finally {
        if (saveBtn) {
          saveBtn.removeAttribute('disabled');
          saveBtn.classList.remove('opacity-50');
        }
      }
    });
  </script>
</AdminLayout>

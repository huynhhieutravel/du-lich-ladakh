<AdminLayout title="Media Library" activeMenu="media">
<style is:inline>
  .media-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
  .media-header h2{font-size:24px;font-weight:700}
  .media-header-right{display:flex;gap:10px}
  .btn-upload{padding:9px 20px;border-radius:8px;font-size:13px;font-weight:700;border:none;background:#2563eb;color:#fff;cursor:pointer;display:inline-flex;align-items:center;gap:6px}
  .btn-upload:hover{background:#1d4ed8}
  .btn-outline{padding:8px 16px;border-radius:8px;font-size:13px;font-weight:600;border:1px solid #d1d5db;background:#fff;color:#374151;cursor:pointer}

  .stats-bar{display:flex;gap:20px;margin-bottom:20px;padding:14px 20px;background:#fff;border-radius:12px;border:1px solid #e2e8f0}
  .stat-item{display:flex;align-items:center;gap:10px;padding:4px 8px;border-radius:8px;transition:background .15s}
  .stat-item:hover{background:#f1f5f9}
  .stat-icon{width:36px;height:36px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px}
  .stat-icon.b{background:#dbeafe}.stat-icon.g{background:#dcfce7}.stat-icon.p{background:#f3e8ff}.stat-icon.a{background:#fef3c7}
  .stat-num{font-size:17px;font-weight:700;color:#0f172a}
  .stat-label{font-size:11px;color:#6b7280}
  .stat-div{width:1px;background:#e5e7eb;margin:0 6px}

  .media-toolbar{display:flex;align-items:center;gap:10px;margin-bottom:16px;flex-wrap:wrap}
  .toolbar-select{padding:7px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:12px;color:#374151;background:#fff}
  .toolbar-search{display:flex;margin-left:auto}
  .toolbar-search input{padding:7px 12px;border:1px solid #d1d5db;border-radius:8px 0 0 8px;font-size:12px;width:180px;outline:none}
  .toolbar-search button{padding:7px 14px;border:1px solid #2563eb;border-left:none;border-radius:0 8px 8px 0;background:#2563eb;color:#fff;font-size:12px;font-weight:600;cursor:pointer}
  .bulk-actions{display:none;align-items:center;gap:8px;padding:8px 14px;background:#eff6ff;border-radius:8px;font-size:13px;color:#2563eb;font-weight:600}
  .bulk-actions.visible{display:flex}
  .bulk-actions button{padding:5px 12px;border-radius:6px;font-size:12px;cursor:pointer;border:1px solid #bfdbfe;background:#fff;color:#2563eb;font-weight:600}
  .bulk-actions .btn-del{border-color:#fecaca;color:#ef4444;background:#fef2f2}

  /* Upload Zone / Drag Drop */
  .upload-zone{border:2px dashed #cbd5e1;border-radius:16px;padding:48px;text-align:center;margin-bottom:24px;background:#f8fafc;transition:all .2s;cursor:pointer;display:none}
  .upload-zone.visible{display:block}
  .upload-zone:hover, .upload-zone.dragover{border-color:#2563eb;background:#eff6ff}
  .upload-zone .uz-icon{font-size:40px;margin-bottom:12px;pointer-events:none}
  .upload-zone .uz-title{font-size:16px;font-weight:600;color:#0f172a;margin-bottom:6px;pointer-events:none}
  .upload-zone .uz-sub{font-size:13px;color:#6b7280;pointer-events:none}
  .upload-zone .uz-btn{display:inline-block;margin-top:14px;padding:8px 20px;background:#2563eb;color:#fff;border-radius:8px;font-size:13px;font-weight:600;pointer-events:none}
  
  /* Global Drag Overlay */
  .drag-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(37,99,235,0.9);z-index:9999;display:none;align-items:center;justify-content:center;flex-direction:column;color:#fff;font-size:24px;font-weight:700}
  .drag-overlay.active{display:flex}
  .drag-overlay * { pointer-events: none; } /* Chống chớp tắt dragleave */

  /* Grid + Detail layout */
  .media-body{display:grid;grid-template-columns:1fr;gap:0;transition:all .2s}
  .media-body.has-detail{grid-template-columns:1fr 400px;gap:24px}

  /* Responsive Detail Panel */
  @media (max-width: 1024px) {
    .media-body.has-detail{grid-template-columns:1fr;}
    .detail-panel{position:fixed;top:0;right:0;bottom:0;width:100%;max-width:400px;height:100vh;max-height:100vh;z-index:9999;border-radius:0;box-shadow:-4px 0 24px rgba(0,0,0,0.1);border:none;}
  }

  .media-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:14px; align-content: start;}
  .empty-state{grid-column: 1 / -1; padding: 60px; text-align: center; color: #64748b; font-size: 15px; border: 2px dashed #e2e8f0; border-radius: 12px; background: #f8fafc;}
  .media-card{background:#fff;border-radius:10px;border:2px solid #e2e8f0;overflow:hidden;cursor:pointer;transition:all .15s;position:relative}
  .media-card:hover{border-color:#93c5fd;transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.08)}
  .media-card.selected{border-color:#2563eb;box-shadow:0 0 0 2px rgba(37,99,235,.3)}
  .media-card .thumb{width:100%;aspect-ratio:1;object-fit:cover;display:block;background:#f1f5f9}
  .media-card .info{padding:8px 10px}
  .media-card .fname{font-size:11px;font-weight:500;color:#0f172a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .media-card .fmeta{font-size:10px;color:#9ca3af;margin-top:2px}
  .media-card .check-mark{position:absolute;top:8px;right:8px;width:22px;height:22px;border-radius:50%;border:2px solid rgba(255,255,255,.8);background:rgba(0,0,0,.25);display:flex;align-items:center;justify-content:center;color:#fff;font-size:13px;opacity:0;transition:opacity .15s}
  .media-card:hover .check-mark{opacity:1}
  .media-card.selected .check-mark{opacity:1;background:#2563eb;border-color:#2563eb}

  /* Detail panel */
  .detail-panel{background:#fff;border-radius:12px;border:1px solid #e2e8f0;padding:20px;position:sticky;top:80px;display:none;max-height:calc(100vh - 120px);overflow-y:auto}
  .detail-panel.visible{display:block}
  
  .detail-header-bar{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid #f1f5f9}
  .detail-nav{display:flex;align-items:center;gap:8px}
  .detail-nav-btn{width:32px;height:32px;border-radius:8px;border:1px solid #e2e8f0;background:#fff;color:#374151;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:700}
  .detail-nav-btn:hover:not(:disabled){background:#f1f5f9;border-color:#cbd5e1}
  .detail-nav-btn:disabled{opacity:0.4;cursor:not-allowed}
  .detail-nav-info{font-size:13px;color:#64748b;font-weight:500;margin:0 4px}
  
  .detail-close{width:32px;height:32px;border-radius:8px;border:none;background:#fef2f2;color:#ef4444;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;font-weight:700}
  .detail-close:hover{background:#fee2e2}
  
  .detail-preview{width:100%;border-radius:10px;margin-bottom:16px;max-height:240px;object-fit:contain;background:#f8fafc;display:block}
  .detail-filename{font-size:14px;font-weight:700;color:#0f172a;margin-bottom:4px;word-break:break-all}
  .detail-filemeta{font-size:12px;color:#6b7280;margin-bottom:16px}

  .detail-field{margin-bottom:14px}
  .detail-field label{display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px}
  .detail-field input,.detail-field textarea{width:100%;padding:8px 12px;border:1px solid #e5e7eb;border-radius:8px;font-size:13px;color:#0f172a;outline:none;box-sizing:border-box;font-family:inherit;transition:border-color .15s}
  .detail-field input:focus,.detail-field textarea:focus{border-color:#2563eb;box-shadow:0 0 0 2px rgba(37,99,235,.1)}
  .detail-field textarea{resize:vertical;min-height:60px}

  .detail-url{display:flex;gap:6px;margin-bottom:16px}
  .detail-url input{flex:1;padding:7px 10px;border:1px solid #e5e7eb;border-radius:8px;font-size:11px;color:#6b7280;background:#f9fafb;box-sizing:border-box}
  .detail-url button{padding:7px 12px;border:1px solid #d1d5db;border-radius:8px;background:#fff;color:#374151;font-size:11px;font-weight:600;cursor:pointer;white-space:nowrap}
  .detail-url button:hover{background:#f3f4f6}

  .detail-actions{display:flex;gap:8px;margin-top:16px;padding-top:16px;border-top:1px solid #f3f4f6}
  .detail-actions button{flex:1;padding:10px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px}
  .btn-save{border:none;background:#2563eb;color:#fff;transition:all .15s}.btn-save:hover{background:#1d4ed8}
  .btn-delete{border:1px solid #fecaca;background:#fef2f2;color:#ef4444}.btn-delete:hover{background:#fee2e2}

  .pg{display:flex;justify-content:center;align-items:center;gap:4px;margin-top:24px}
  .pg-btn{padding:7px 12px;border:1px solid #d1d5db;border-radius:6px;background:#fff;color:#374151;font-size:13px;cursor:pointer}
  .pg-btn:hover{background:#f3f4f6}
  .pg-btn.active{background:#2563eb;color:#fff;border-color:#2563eb}
  .pg-info{font-size:12px;color:#6b7280;margin:0 12px}
</style>

<!-- Global Drag Overlay -->
<div class="drag-overlay" id="dragOverlay">
  <div style="font-size:60px;margin-bottom:20px">☁️</div>
  <div>Drop files anywhere to upload</div>
</div>

<!-- Header -->
<div class="media-header">
  <h2>Media Library</h2>
  <div class="media-header-right">
    <button class="btn-outline" onclick="document.getElementById('uploadZone').classList.toggle('visible')">📤 Upload Area</button>
    <button class="btn-upload" onclick="document.getElementById('uploadZone').classList.add('visible'); window.scrollTo({top:0,behavior:'smooth'})">+ Upload New</button>
  </div>
</div>

<!-- Stats -->
<div class="stats-bar">
  <div class="stat-item" onclick="filterByType('images')" style="cursor:pointer" title="Lọc xem hình ảnh"><div class="stat-icon b">🖼</div><div><div class="stat-num" id="statImg">{totalImages.toLocaleString('vi-VN')}</div><div class="stat-label">Images</div></div></div>
  <div class="stat-div"></div>
  <div class="stat-item" onclick="filterByType('documents')" style="cursor:pointer" title="Lọc xem tài liệu"><div class="stat-icon g">📄</div><div><div class="stat-num" id="statDocs">{totalDocs.toLocaleString('vi-VN')}</div><div class="stat-label">Documents</div></div></div>
  <div class="stat-div"></div>
  <div class="stat-item" onclick="filterByType('videos')" style="cursor:pointer" title="Lọc xem video"><div class="stat-icon p">🎬</div><div><div class="stat-num" id="statVideos">{totalVideos.toLocaleString('vi-VN')}</div><div class="stat-label">Videos</div></div></div>
  <div class="stat-div"></div>
  <div class="stat-item" onclick="filterByType('all')" style="cursor:pointer" title="Xem toàn bộ thư viện"><div class="stat-icon a">💾</div><div><div class="stat-num" id="statUsed">{formattedUsed}</div><div class="stat-label">Used</div></div></div>
</div>

<!-- Upload zone -->
<div class="upload-zone" id="uploadZone">
  <div class="uz-icon">☁️</div>
  <div class="uz-title">Drag & drop files here</div>
  <div class="uz-sub">or click to browse from your computer</div>
  <div class="uz-btn">Browse Files</div>
  <input type="file" multiple id="fileInput" accept="image/*" style="display:none" />
</div>

<!-- Toolbar -->
<div class="media-toolbar">
  <div class="bulk-actions" id="bulkActions">
    <span id="selectedCount">0 selected</span>
    <button>📥 Download</button>
    <button onclick="copySelectedLinks()" style="border-color:#10b981;color:#059669;background:#ecfdf5">📋 Copy Links</button>
    <button class="btn-del" onclick="deleteSelected()">🗑 Delete</button>
    <button onclick="deselectAll()">✕ Clear</button>
  </div>
  <select class="toolbar-select" id="typeSelect" onchange="handleTypeFilter()">
    <option value="all">All types</option>
    <option value="images">Images</option>
    <option value="videos">Videos</option>
    <option value="documents">Documents</option>
  </select>
  <select class="toolbar-select" id="dateSelect" onchange="handleDateFilter()">
    <option value="all">All dates</option>
  </select>
  <select class="toolbar-select" id="seoFilter" onchange="handleSeoFilter()">
    <option value="all">SEO: All Media</option>
    <option value="missing_alt">SEO: Missing Alt Text</option>
  </select>
  <select class="toolbar-select" id="sortSelect" onchange="handleSort()">
    <option value="newest">Sort: Newest</option>
    <option value="oldest">Sort: Oldest</option>
    <option value="name">Sort: Name (A-Z)</option>
  </select>
  <div class="toolbar-search"><input type="text" placeholder="Search media..." oninput="handleSearch(this.value)" /><button>Search</button></div>
</div>

<!-- Body: Grid + Detail -->
<div class="media-body" id="mediaBody">
  <div class="media-grid" id="mediaGrid"></div>
  
  <!-- Detail Panel -->
  <div class="detail-panel" id="detailPanel">
    <div class="detail-header-bar">
      <div class="detail-nav">
        <button class="detail-nav-btn" id="btnPrevImg" onclick="navigateImage(-1)" title="Previous Image">←</button>
        <span class="detail-nav-info" id="detailIndex">0 of 0</span>
        <button class="detail-nav-btn" id="btnNextImg" onclick="navigateImage(1)" title="Next Image">→</button>
      </div>

---
import AdminLayout from '@/layouts/AdminLayout.astro';

import { env } from 'cloudflare:workers';

Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, max-age=0');

// Fetch media from D1 (works both locally via platformProxy and on Cloudflare)
let mediaList: any[] = [];
const d1Db = (env as any)?.ladakh_d1 || (Astro.locals as any)?.runtime?.env?.ladakh_d1;
if (d1Db) {
  try {
    const { results } = await d1Db.prepare("SELECT * FROM Media ORDER BY createdAt DESC").all();
    mediaList = results || [];
  } catch (err) {
    console.error("D1 Fetch Error:", err);
  }
} else {
  console.warn("No D1 binding found.");
}

// Compute overview stats for SSR
let totalImages = 0;
let totalDocs = 0;
let totalVideos = 0;
let totalBytes = 0;

for (const item of mediaList) {
  const mime = (item.mimeType || '').toLowerCase();
  const filename = (item.filename || '').toLowerCase();
  const size = Number(item.sizeBytes) || 0;
  totalBytes += size;

  if (mime.startsWith('video/') || /\.(mp4|webm|ogg|mov|avi|mkv)$/i.test(filename)) {
    totalVideos++;
  } else if (mime.includes('pdf') || mime.includes('document') || mime.includes('text') || /\.(pdf|docx?|xlsx?|pptx?|txt)$/i.test(filename)) {
    totalDocs++;
  } else {
    totalImages++;
  }
}

function formatBytes(bytes: number) {
  if (!bytes || bytes <= 0) return '0 MB';
  const gb = bytes / (1024 * 1024 * 1024);
  if (gb >= 1) {
    return gb.toFixed(2) + ' GB';
  }
  const mb = bytes / (1024 * 1024);
  return mb.toFixed(1) + ' MB';
}

const formattedUsed = formatBytes(totalBytes);

// Format data for the client-side JS - Keep server-side operations minimal!
const initialData = mediaList.map(item => {
  const cleanFilename = item.filename ? item.filename.replace(/^uploads\//, '') : '';
  return {
    id: item.id,
    src: item.url,
    name: cleanFilename,
    size: item.sizeBytes ? (item.sizeBytes / 1024).toFixed(1) + ' KB' : 'Unknown',
    sizeBytes: item.sizeBytes || 0,
    mimeType: item.mimeType || '',
    dim: (item.width && item.height) ? `${item.width}×${item.height}` : '',
    alt: (item.altText || '').trim(),
    title: (item.title || cleanFilename).trim(),
    caption: (item.caption || '').trim(),
    desc: (item.description || '').trim(),
    date: item.createdAt || new Date().toISOString()
  };
});

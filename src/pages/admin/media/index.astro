    </div>
    
    <img class="detail-preview" id="detailImg" src="" alt="" />
    <div class="detail-filename" id="detailName"></div>
    <div class="detail-filemeta" id="detailMeta"></div>
    
    <div class="detail-url">
      <input type="text" id="detailUrl" readonly />
      <button onclick="copyUrl()">📋 Copy</button>
    </div>
    
    <div class="detail-field">
      <label>Alt Text (SEO)</label>
      <input type="text" id="fieldAlt" placeholder="Mô tả nội dung ảnh cho SEO..." oninput="triggerAutoSave()" />
    </div>
    <div class="detail-field">
      <label>Title</label>
      <input type="text" id="fieldTitle" oninput="triggerAutoSave()" />
    </div>
    <div class="detail-field">
      <label>Caption</label>
      <textarea id="fieldCaption" rows="2" placeholder="Chú thích hiện dưới ảnh..." oninput="triggerAutoSave()"></textarea>
    </div>
    <div class="detail-field">
      <label>Description</label>
      <textarea id="fieldDesc" rows="3" placeholder="Mô tả chi tiết..." oninput="triggerAutoSave()"></textarea>
    </div>
    
    <div class="detail-actions" style="justify-content: space-between; align-items: center;">
      <span id="saveStatus" style="font-size: 13px; font-weight: 600; color: #6b7280; margin-left: 4px;"></span>
      <button class="btn-delete" style="flex: 0 1 auto; padding: 8px 16px;" onclick="deleteActive()">🗑 Delete Image</button>
    </div>
  </div>
</div>

<!-- Pagination -->
<div class="pg" id="paginationContainer"></div>

<script is:inline src="/scripts/browser-image-compression.js" onerror="this.onerror=null;this.src='https://cdn.jsdelivr.net/npm/browser-image-compression@2.0.2/dist/browser-image-compression.js'"></script>
<script is:inline src="/scripts/exifr.full.umd.js" onerror="this.onerror=null;this.src='https://cdn.jsdelivr.net/npm/exifr@7.1.3/dist/full.umd.js'"></script>
<script is:inline define:vars={{ initialData }}>
let MEDIA_DATA = (initialData || []).map(m => {
  const d = new Date(m.date);
  m.displayDate = d.toLocaleDateString('vi-VN', { month: 'short', day: 'numeric', year: 'numeric' }) + ' ' + d.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
  return m;
});
let selectedIds = new Set();
let activeId = null;
let lastClickedId = null; // Dùng cho Shift+Click
let currentPage = 1;
const itemsPerPage = 40;
let searchQuery = '';
let currentSort = 'newest';
let currentDateFilter = 'all';
let currentSeoFilter = 'all';
let currentTypeFilter = 'all';

function normalizeStr(str) {
  if (!str) return '';
  return str.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D').toLowerCase();
}

function handleSearch(query) {
  searchQuery = query;
  currentPage = 1;
  renderGrid();
}

function handleSort() {
  currentSort = document.getElementById('sortSelect').value;
  currentPage = 1;
  renderGrid();
}

function handleDateFilter() {
  currentDateFilter = document.getElementById('dateSelect').value;
  currentPage = 1;
  renderGrid();
}

function handleSeoFilter() {
  currentSeoFilter = document.getElementById('seoFilter').value;
  currentPage = 1;
  renderGrid();
}

function handleTypeFilter() {
  currentTypeFilter = document.getElementById('typeSelect').value;
  currentPage = 1;
  renderGrid();
}

function filterByType(type) {
  currentTypeFilter = type;
  const sel = document.getElementById('typeSelect');
  if (sel) sel.value = type;
  currentPage = 1;
  renderGrid();
}

function changePage(delta) {
  const displayData = getDisplayData();
  const totalPages = Math.ceil(displayData.length / itemsPerPage) || 1;
  const newPage = currentPage + delta;
  if (newPage >= 1 && newPage <= totalPages) {
    currentPage = newPage;
    renderGrid();
  }
}

function goToPage(p) {
  currentPage = p;
  renderGrid();
}

function getDisplayData() {
  let filtered = MEDIA_DATA;
  
  if (currentTypeFilter === 'images') {
    filtered = filtered.filter(m => {
      const mime = (m.mimeType || '').toLowerCase();
      const name = (m.name || m.src || '').toLowerCase();
      return !mime.startsWith('video/') && !/\.(mp4|webm|ogg|mov|avi|mkv)$/i.test(name) &&
             !mime.includes('pdf') && !mime.includes('document') && !mime.includes('text') && !/\.(pdf|docx?|xlsx?|pptx?|txt)$/i.test(name);
    });
  } else if (currentTypeFilter === 'videos') {
    filtered = filtered.filter(m => {
      const mime = (m.mimeType || '').toLowerCase();
      const name = (m.name || m.src || '').toLowerCase();
      return mime.startsWith('video/') || /\.(mp4|webm|ogg|mov|avi|mkv)$/i.test(name);
    });
  } else if (currentTypeFilter === 'documents') {
    filtered = filtered.filter(m => {
      const mime = (m.mimeType || '').toLowerCase();
      const name = (m.name || m.src || '').toLowerCase();
      return mime.includes('pdf') || mime.includes('document') || mime.includes('text') || /\.(pdf|docx?|xlsx?|pptx?|txt)$/i.test(name);
    });
  }

  if (searchQuery) {
    const qNorm = normalizeStr(searchQuery);
    filtered = filtered.filter(m => 
      normalizeStr(m.name).includes(qNorm) || 
      normalizeStr(m.alt).includes(qNorm) || 
      normalizeStr(m.title).includes(qNorm) ||
      normalizeStr(m.desc).includes(qNorm) ||
      normalizeStr(m.caption).includes(qNorm)
    );
  }

  if (currentDateFilter !== 'all') {
    filtered = filtered.filter(m => {
      const d = new Date(m.date);
      if (isNaN(d.getTime())) return false;
      const mDateStr = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
      return mDateStr === currentDateFilter;
    });
  }
  
  if (currentSeoFilter === 'missing_alt') {
    filtered = filtered.filter(m => !m.alt || m.alt.trim() === '');
  }
  
  return filtered.sort((a, b) => {
    if (currentSort === 'newest') {
      const dateDiff = new Date(b.date).getTime() - new Date(a.date).getTime();
      if (dateDiff !== 0) return dateDiff;
      return String(b.id).localeCompare(String(a.id));
    } else if (currentSort === 'oldest') {
      const dateDiff = new Date(a.date).getTime() - new Date(b.date).getTime();
      if (dateDiff !== 0) return dateDiff;
      return String(a.id).localeCompare(String(b.id));
    } else if (currentSort === 'name') {
      return a.name.localeCompare(b.name);
    }
    return 0;
  });
}

function getThumbnailHtml(m) {
  const mime = (m.mimeType || '').toLowerCase();
  const name = (m.name || m.src || '').toLowerCase();
  if (mime.startsWith('video/') || /\.(mp4|webm|ogg|mov|avi|mkv)$/i.test(name)) {
    return `<div class="thumb" style="display:flex;align-items:center;justify-content:center;background:#f3e8ff;color:#7c3aed;font-size:32px;"><span style="font-size:28px">🎬</span></div>`;
  }
  if (mime.includes('pdf') || mime.includes('document') || mime.includes('text') || /\.(pdf|docx?|xlsx?|pptx?|txt)$/i.test(name)) {
    return `<div class="thumb" style="display:flex;align-items:center;justify-content:center;background:#fef2f2;color:#dc2626;font-size:32px;"><span style="font-size:28px">📄</span></div>`;
  }
  return `<img class="thumb" src="${m.src}" alt="${m.alt}" loading="lazy" />`;
}

function updateStats() {
  let imgCount = 0;
  let docCount = 0;
  let vidCount = 0;
  let totalBytes = 0;

  MEDIA_DATA.forEach(m => {
    const mime = (m.mimeType || '').toLowerCase();
    const name = (m.name || m.src || '').toLowerCase();
    const bytes = Number(m.sizeBytes) || 0;
    totalBytes += bytes;

    if (mime.startsWith('video/') || /\.(mp4|webm|ogg|mov|avi|mkv)$/i.test(name)) {
      vidCount++;
    } else if (mime.includes('pdf') || mime.includes('document') || mime.includes('text') || /\.(pdf|docx?|xlsx?|pptx?|txt)$/i.test(name)) {
      docCount++;
    } else {
      imgCount++;
    }
  });

  const elImg = document.getElementById('statImg');
  const elDocs = document.getElementById('statDocs');
  const elVideos = document.getElementById('statVideos');
  const elUsed = document.getElementById('statUsed');

  if (elImg) elImg.textContent = imgCount.toLocaleString('vi-VN');
  if (elDocs) elDocs.textContent = docCount.toLocaleString('vi-VN');
  if (elVideos) elVideos.textContent = vidCount.toLocaleString('vi-VN');
  if (elUsed) {
    if (totalBytes >= 1024 * 1024 * 1024) {
      elUsed.textContent = (totalBytes / (1024 * 1024 * 1024)).toFixed(2) + ' GB';
    } else if (totalBytes >= 1024 * 1024) {
      elUsed.textContent = (totalBytes / (1024 * 1024)).toFixed(1) + ' MB';
    } else {
      elUsed.textContent = (totalBytes / 1024).toFixed(1) + ' KB';
    }
  }
}

// RENDER GRID
function renderGrid() {
  const grid = document.getElementById('mediaGrid');
  const displayData = getDisplayData();
  const totalItems = displayData.length;
  const totalPages = Math.ceil(totalItems / itemsPerPage) || 1;
  
  if (currentPage > totalPages) currentPage = totalPages;
  
  const pgContainer = document.getElementById('paginationContainer');

  if (totalItems === 0) {
    grid.innerHTML = `<div class="empty-state">No media found. Drag and drop files here to upload.</div>`;
    if(pgContainer) pgContainer.innerHTML = `<span class="pg-info">0 items</span>`;
    return;
  }

  // Update Numeric Pagination UI
  if (pgContainer) {
    let pgHtml = '';
    if (totalPages > 1) {
      pgHtml += `<button class="pg-btn" onclick="changePage(-1)" ${currentPage === 1 ? 'disabled style="opacity:0.5"' : ''}>← Prev</button>`;
      
      let startP = Math.max(1, currentPage - 2);
      let endP = Math.min(totalPages, currentPage + 2);
      if (startP > 1) {
        pgHtml += `<button class="pg-btn" onclick="goToPage(1)">1</button>`;
        if (startP > 2) pgHtml += `<span style="color:#94a3b8">...</span>`;
      }
      
      for (let p = startP; p <= endP; p++) {
        pgHtml += `<button class="pg-btn ${p === currentPage ? 'active' : ''}" onclick="goToPage(${p})">${p}</button>`;
      }
      
      if (endP < totalPages) {
        if (endP < totalPages - 1) pgHtml += `<span style="color:#94a3b8">...</span>`;
        pgHtml += `<button class="pg-btn" onclick="goToPage(${totalPages})">${totalPages}</button>`;
      }
      
      pgHtml += `<button class="pg-btn" onclick="changePage(1)" ${currentPage === totalPages ? 'disabled style="opacity:0.5"' : ''}>Next →</button>`;
      pgHtml += `<span class="pg-info">${totalItems.toLocaleString()} items</span>`;
      
      // Page Jump Input
      pgHtml += `<div style="display:flex;align-items:center;gap:6px;margin-left:8px;border-left:1px solid #e2e8f0;padding-left:16px;">
        <span style="font-size:12px;color:#64748b;">Jump to</span>
        <input type="number" min="1" max="${totalPages}" value="${currentPage}" 
               style="width:54px;padding:5px 8px;border:1px solid #cbd5e1;border-radius:6px;font-size:13px;text-align:center;outline:none;color:#334155;background:#fff"
               onkeydown="if(event.key==='Enter'){ const p=parseInt(this.value); if(p>=1 && p<=${totalPages}) goToPage(p); else this.value=${currentPage}; }"
               onblur="const p=parseInt(this.value); if(p>=1 && p<=${totalPages} && p!==${currentPage}) goToPage(p); else this.value=${currentPage};" />
      </div>`;
    } else {
      pgHtml = `<span class="pg-info">${totalItems.toLocaleString()} items</span>`;
    }
    pgContainer.innerHTML = pgHtml;
  }

  const startIdx = (currentPage - 1) * itemsPerPage;
  const endIdx = startIdx + itemsPerPage;
  const paginatedData = displayData.slice(startIdx, endIdx);

  grid.innerHTML = paginatedData.map(m => `
    <div class="media-card ${selectedIds.has(m.id)?'selected':''} ${activeId===m.id?'selected':''}" 
         data-id="${m.id}" onclick="handleCardClick(event,${m.id})">
      <div class="check-mark" onclick="toggleSelection(${m.id}, event)">${selectedIds.has(m.id)?'✓':'✓'}</div>
      ${getThumbnailHtml(m)}
      <div class="info"><div class="fname">${m.name}</div><div class="fmeta">${m.size} · ${m.dim}</div></div>
    </div>
  `).join('');
}

// INTERACTIONS
function toggleSelection(id, event) {
  flushAutoSave();
  if (event) event.stopPropagation();
  if (selectedIds.has(id)) {
    selectedIds.delete(id);
  } else {
    selectedIds.add(id);
  }
  lastClickedId = id;
  activeId = null;
  document.getElementById('detailPanel').classList.remove('visible');
  document.getElementById('mediaBody').classList.remove('has-detail');
  updateBulk();
  renderGrid();
}

function handleCardClick(e, id) {
  flushAutoSave();
  const displayData = getDisplayData();
  
  if (e.shiftKey && lastClickedId !== null) {
    // Chọn nhiều bằng Shift
    const startIdx = displayData.findIndex(x => String(x.id) === String(lastClickedId));
    const endIdx = displayData.findIndex(x => String(x.id) === String(id));
    if (startIdx !== -1 && endIdx !== -1) {
      const min = Math.min(startIdx, endIdx);
      const max = Math.max(startIdx, endIdx);
      for (let i = min; i <= max; i++) {
        selectedIds.add(displayData[i].id);
      }
    }
    activeId = null;
    document.getElementById('detailPanel').classList.remove('visible');
    document.getElementById('mediaBody').classList.remove('has-detail');
  } else if (e.ctrlKey || e.metaKey) {
    // Multi-select từng cái
    if (selectedIds.has(id)) selectedIds.delete(id); else selectedIds.add(id);
    lastClickedId = id;
    activeId = null;
    document.getElementById('detailPanel').classList.remove('visible');
    document.getElementById('mediaBody').classList.remove('has-detail');
  } else {
    // Chọn 1 cái để Edit
    selectedIds.clear();
    lastClickedId = id;
    activeId = id;
    openDetail(id);
  }
  updateBulk();
  renderGrid();
}

function updateBulk() {
  const bulk = document.getElementById('bulkActions');
  const count = document.getElementById('selectedCount');
  if (selectedIds.size > 0) {
    bulk.classList.add('visible');
    count.textContent = selectedIds.size + ' selected';
  } else {
    bulk.classList.remove('visible');
  }
}

function deselectAll() {
  flushAutoSave();
  selectedIds.clear();
  activeId = null;
  closeDetail();
  updateBulk();
  renderGrid();
}

window.copySelectedLinks = function() {
  const displayData = getDisplayData();
  const links = displayData
    .filter(m => selectedIds.has(m.id))
    .map(m => m.src)
    .join('\n');
  
  if (links) {
    navigator.clipboard.writeText(links);
    window.AppModal.alert('Đã copy ' + selectedIds.size + ' link ảnh vào clipboard!');
    deselectAll();
  }
}

async function deleteSelected() {
  const confirmed = await window.AppModal.confirm(`Bạn có chắc muốn xoá ${selectedIds.size} file đã chọn?`);
  if (!confirmed) return;
  const idsArray = Array.from(selectedIds);
  fetch('/api/admin/media', {
    method: 'DELETE',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ ids: idsArray })
  }).then(r => r.json()).then(resData => {
    if (resData.success) {
      MEDIA_DATA = MEDIA_DATA.filter(m => !selectedIds.has(m.id));
      deselectAll();
      updateStats();
    } else {
      window.AppModal.alert(resData.error?.message || 'Lỗi khi xóa', 'error');
    }
  }).catch(err => console.error('Delete API error:', err));
}

async function deleteActive() {
  const confirmed = await window.AppModal.confirm("Bạn có chắc muốn xoá file này?");
  if (!confirmed) return;
  fetch('/api/admin/media', {
    method: 'DELETE',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ ids: [activeId] })
  }).then(r => r.json()).then(resData => {
    if (resData.success) {
      MEDIA_DATA = MEDIA_DATA.filter(m => String(m.id) !== String(activeId));
      closeDetail();
      updateStats();
    } else {
      window.AppModal.alert(resData.error?.message || 'Lỗi khi xóa', 'error');
    }
  }).catch(err => console.error('Delete API error:', err));
}

// DETAIL PANEL
function openDetail(id) {
  const m = MEDIA_DATA.find(x => String(x.id) === String(id));
  if (!m) return;
  
  // Fill data
  const mime = (m.mimeType || '').toLowerCase();
  const name = (m.name || m.src || '').toLowerCase();
  const isVid = mime.startsWith('video/') || /\.(mp4|webm|ogg|mov|avi|mkv)$/i.test(name);
  const isDoc = mime.includes('pdf') || mime.includes('document') || mime.includes('text') || /\.(pdf|docx?|xlsx?|pptx?|txt)$/i.test(name);

  const previewEl = document.getElementById('detailImg');
  if (isVid) {
    previewEl.src = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="400" height="240" viewBox="0 0 400 240"><rect width="100%" height="100%" fill="%23f3e8ff"/><text x="50%" y="45%" dominant-baseline="middle" text-anchor="middle" font-size="48">🎬</text><text x="50%" y="70%" dominant-baseline="middle" text-anchor="middle" font-family="sans-serif" font-size="14" fill="%237c3aed" font-weight="bold">Video file</text></svg>';
  } else if (isDoc) {
    previewEl.src = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="400" height="240" viewBox="0 0 400 240"><rect width="100%" height="100%" fill="%23fef2f2"/><text x="50%" y="45%" dominant-baseline="middle" text-anchor="middle" font-size="48">📄</text><text x="50%" y="70%" dominant-baseline="middle" text-anchor="middle" font-family="sans-serif" font-size="14" fill="%23dc2626" font-weight="bold">Document / PDF</text></svg>';
  } else {
    previewEl.src = m.src;
  }

  document.getElementById('detailName').textContent = m.name;
  document.getElementById('detailMeta').textContent = `${m.size}${m.dim ? ' · ' + m.dim : ''} · ${m.displayDate}`;
  document.getElementById('detailUrl').value = m.src;
  
  // 4 TRƯỜNG METADATA (Sẽ rỗng nếu ảnh mới upload)
  document.getElementById('fieldAlt').value = m.alt || '';
  document.getElementById('fieldTitle').value = m.title || '';
  document.getElementById('fieldCaption').value = m.caption || '';
  document.getElementById('fieldDesc').value = m.desc || '';
  
  // Reset Save Status
  const status = document.getElementById('saveStatus');
  if(status) status.textContent = '';
  
  // Update Navigation UI
  const index = MEDIA_DATA.findIndex(x => String(x.id) === String(id));
  document.getElementById('detailIndex').textContent = `${index + 1} of ${MEDIA_DATA.length}`;
  document.getElementById('btnPrevImg').disabled = (index === 0);
  document.getElementById('btnNextImg').disabled = (index === MEDIA_DATA.length - 1);
  
  // Show Panel
  document.getElementById('detailPanel').classList.add('visible');
  document.getElementById('mediaBody').classList.add('has-detail');
  
  // Scroll to active card smoothly
  const card = document.querySelector(`.media-card[data-id="${id}"]`);
  if (card) {
    const cardRect = card.getBoundingClientRect();
    if(cardRect.top < 100 || cardRect.bottom > window.innerHeight) {
      card.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }
}

function closeDetail() {
  flushAutoSave();
  document.getElementById('detailPanel').classList.remove('visible');
  document.getElementById('mediaBody').classList.remove('has-detail');
  activeId = null;
  renderGrid();
}

// NAVIGATION
function navigateImage(direction) {
  if (!activeId) return;
  flushAutoSave();
  const displayData = getDisplayData();
  const index = displayData.findIndex(x => String(x.id) === String(activeId));
  const newIndex = index + direction;
  if (newIndex >= 0 && newIndex < displayData.length) {
    activeId = displayData[newIndex].id;
    lastClickedId = activeId;
    
    // Auto-change page if navigating out of current view
    const newPage = Math.floor(newIndex / itemsPerPage) + 1;
    if (newPage !== currentPage) {
      currentPage = newPage;
      renderGrid();
    }
    
    openDetail(activeId);
  }
}

// KEYBOARD NAVIGATION
document.addEventListener('keydown', (e) => {
  if (!activeId || !document.getElementById('detailPanel').classList.contains('visible')) return;
  // Bỏ qua nếu đang gõ text
  if (['INPUT','TEXTAREA'].includes(document.activeElement.tagName)) return;
  
  if (e.key === 'ArrowLeft') { navigateImage(-1); e.preventDefault(); }
  if (e.key === 'ArrowRight') { navigateImage(1); e.preventDefault(); }
  if (e.key === 'Escape') closeDetail();
});

let autoSaveTimeout;

function flushAutoSave() {
  if (autoSaveTimeout) {
    clearTimeout(autoSaveTimeout);
    autoSaveTimeout = null;
    performAutoSave();
  }
}

function triggerAutoSave() {
  const status = document.getElementById('saveStatus');
  if (status) {
    status.textContent = '✎ Typing...';
    status.style.color = '#d97706'; // Amber
  }
  
  clearTimeout(autoSaveTimeout);
  autoSaveTimeout = setTimeout(() => {
    autoSaveTimeout = null;
    performAutoSave();
  }, 600); // Lưu sau 600ms ngừng gõ
}

function performAutoSave() {
  if (!activeId) return;
  const m = MEDIA_DATA.find(x => String(x.id) === String(activeId));
  if (!m) return;

  const newAlt = document.getElementById('fieldAlt').value;
  const newTitle = document.getElementById('fieldTitle').value;
  const newCaption = document.getElementById('fieldCaption').value;
  const newDesc = document.getElementById('fieldDesc').value;

  // Update local JS object
  m.alt = newAlt;
  m.title = newTitle;
  m.caption = newCaption;
  m.desc = newDesc;

  // Persist to DB
  fetch('/api/admin/media', {
    method: 'PATCH',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      id: activeId,
      altText: newAlt,
      title: newTitle,
      caption: newCaption,
      description: newDesc
    })
  }).then(r => r.json()).then(resData => {
    const status = document.getElementById('saveStatus');
    if (resData.success && status) {
      status.textContent = '✓ Saved to DB';
      status.style.color = '#16a34a';
      setTimeout(() => { if (status.textContent === '✓ Saved to DB') status.textContent = ''; }, 2000);
    } else if (status) {
      status.textContent = '✗ Save failed';
      status.style.color = '#ef4444';
    }
  }).catch(err => {
    console.error('Auto-save API error:', err);
    const status = document.getElementById('saveStatus');
    if (status) {
      status.textContent = '✗ Network error';
      status.style.color = '#ef4444';
    }
  });
}

function copyUrl() {
  const input = document.getElementById('detailUrl');
  navigator.clipboard.writeText(input.value);
  const btn = input.nextElementSibling;
  btn.textContent = '✓ Copied!';
  setTimeout(() => btn.textContent = '📋 Copy', 1500);
}

// ================= DRAG AND DROP (FIXED FLICKERING) =================
const dropZone = document.getElementById('uploadZone');
const fileInput = document.getElementById('fileInput');
const dragOverlay = document.getElementById('dragOverlay');

let dragCounter = 0;

document.addEventListener('dragenter', (e) => {
  e.preventDefault();
  dragCounter++;
  dragOverlay.classList.add('active');
});

document.addEventListener('dragleave', (e) => {
  e.preventDefault();
  dragCounter--;
  if (dragCounter === 0) {
    dragOverlay.classList.remove('active');
  }
});

document.addEventListener('dragover', (e) => {
  e.preventDefault(); // Phải có để cho phép drop
});

document.addEventListener('drop', (e) => {
  e.preventDefault();
  dragCounter = 0;
  dragOverlay.classList.remove('active');
  if(e.dataTransfer.files && e.dataTransfer.files.length > 0) {
    handleFiles(e.dataTransfer.files);
  }
});

// Zone click upload
dropZone.addEventListener('click', () => fileInput.click());
fileInput.addEventListener('change', () => handleFiles(fileInput.files));

function extractExifString(val) {
  if (!val) return '';
  if (typeof val === 'string') return val.trim();
  if (typeof val === 'object') {
    if (typeof val.value === 'string') return val.value.trim();
    if (Array.isArray(val) && val.length > 0) {
      const first = val[0];
      return typeof first === 'string' ? first.trim() : (first?.value || '');
    }
  }
  return String(val).trim();
}

function handleFiles(files) {
  const rawImageFiles = Array.from(files).filter(f => f.type.startsWith('image/'));
  if (rawImageFiles.length === 0) return;

  // Process files async for EXIF extraction & WebP compression
  (async () => {
    window.AppModal?.showLoading?.('Đang đọc thông tin EXIF & nén hình ảnh (WebP)...');
    const processedFiles = [];

    // Đảm bảo exifr đã sẵn sàng
    if (!window.exifr) {
      for (let attempt = 0; attempt < 30; attempt++) {
        await new Promise(r => setTimeout(r, 100));
        if (window.exifr) break;
      }
    }

    for (let f of rawImageFiles) {
      // 1. Trích xuất EXIF / IPTC / XMP metadata từ file ảnh gốc TRƯỚC KHI nén
      let meta = { title: '', altText: '', caption: '', description: '' };
      try {
        if (window.exifr) {
          const arrayBuffer = await f.arrayBuffer();
          const parsed = await window.exifr.parse(arrayBuffer, {
            iptc: true,
            xmp: true,
            tiff: true,
            exif: true,
            jfif: true
          });
          if (parsed) {
            const exifTitle = extractExifString(parsed.title) || extractExifString(parsed.ObjectName) || '';
            const exifDesc = extractExifString(parsed.description) || extractExifString(parsed.ImageDescription) || extractExifString(parsed.Caption) || '';
            
            // Quy tắc theo yêu cầu:
            // Title lấy từ title
            // Alt Text (SEO) lấy thẻ description
            // Caption lấy từ description
            // Description lấy từ title
            const rawFileName = f.name.split('.').slice(0, -1).join('.') || f.name;
            const finalTitle = exifTitle || rawFileName;
            const finalAlt = exifDesc || exifTitle || rawFileName;
            const finalCaption = exifDesc || '';
            const finalDesc = exifTitle || '';

            meta = {
              title: finalTitle,
              altText: finalAlt,
              caption: finalCaption,
              description: finalDesc
            };
          }
        }
      } catch (exifErr) {
        console.warn('Lỗi đọc EXIF cho', f.name, exifErr);
      }

      if (!meta.title) {
        const rawFileName = f.name.split('.').slice(0, -1).join('.') || f.name;
        meta.title = rawFileName;
        meta.altText = rawFileName;
        meta.caption = '';
        meta.description = rawFileName;
      }

      // 2. Nén ảnh sang WebP
      let fileToUpload = f;
      if (f.type !== 'image/gif' && f.type !== 'image/svg+xml') {
        try {
          const compressedBlob = await imageCompression(f, {
            maxSizeMB: 10,
            maxWidthOrHeight: 2500,
            useWebWorker: false,
            initialQuality: 0.85,
            fileType: 'image/webp'
          });
          const newName = f.name.replace(/\.[^/.]+$/, ".webp");
          fileToUpload = new File([compressedBlob], newName, { type: 'image/webp' });
        } catch (err) {
          console.error('Compression failed for', f.name, err);
          fileToUpload = f;
        }
      }

      processedFiles.push({ file: fileToUpload, meta, originalName: f.name });
    }
    window.AppModal?.closeLoading?.();

    // 1. Create placeholder items with loading state
    const placeholders = processedFiles.map((item, i) => {
      const tempId = 'uploading_' + Date.now() + '_' + i;
      const previewSrc = URL.createObjectURL(item.file);
      const sizeKB = (item.file.size / 1024).toFixed(1) + ' KB';
      return {
        id: tempId,
        src: previewSrc,
        name: '⏳ ' + item.file.name,
        size: sizeKB,
        dim: '',
        alt: item.meta.altText,
        title: item.meta.title,
        caption: item.meta.caption,
        desc: item.meta.description,
        date: new Date().toISOString(),
        displayDate: 'Uploading...',
        _file: item.file,        // Keep reference for upload
        _meta: item.meta,
        _isUploading: true
      };
    });

    // 2. Add placeholders to top of list & render
    MEDIA_DATA = [...placeholders, ...MEDIA_DATA];
    renderGrid();

    // 3. Upload each file in parallel
    placeholders.forEach(async (placeholder) => {
      const formData = new FormData();
      formData.append('file', placeholder._file);
      if (placeholder._meta?.title) formData.append('title', placeholder._meta.title);
      if (placeholder._meta?.altText) formData.append('altText', placeholder._meta.altText);
      if (placeholder._meta?.caption) formData.append('caption', placeholder._meta.caption);
      if (placeholder._meta?.description) formData.append('description', placeholder._meta.description);

      try {
        const res = await fetch('/api/admin/upload', {
          method: 'POST',
          body: formData
        });

        if (!res.ok) {
          throw new Error('Upload failed: ' + res.status);
        }

        const resData = await res.json();
        if (!resData.success) {
          throw new Error(resData.error?.message || 'Upload failed');
        }
        const data = resData.data;

        // 4. Replace placeholder with real data
        const idx = MEDIA_DATA.findIndex(m => m.id === placeholder.id);
        if (idx !== -1) {
          const d = new Date(data.createdAt);
          const formattedDate = d.toLocaleDateString('vi-VN', { month: 'short', day: 'numeric', year: 'numeric' }) + ' ' + d.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });

          MEDIA_DATA[idx] = {
            id: data.id,
            src: data.url,
            name: data.filename,
            size: (data.size / 1024).toFixed(1) + ' KB',
            sizeBytes: data.size || 0,
            mimeType: data.mimeType || placeholder._file?.type || '',
            dim: '',
            alt: data.altText || placeholder._meta?.altText || '',
            title: data.title || placeholder._meta?.title || '',
            caption: data.caption || placeholder._meta?.caption || '',
            desc: data.description || placeholder._meta?.description || '',
            date: data.createdAt,
            displayDate: formattedDate
          };

          URL.revokeObjectURL(placeholder.src);
          updateStats();
        }

        renderGrid();

        // Auto-open detail of the first uploaded image
        if (placeholders[0] && data.id && placeholder.id === placeholders[0].id) {
          activeId = data.id;
          openDetail(data.id);
        }

      } catch (err) {
        console.error('Upload error:', err);
        MEDIA_DATA = MEDIA_DATA.filter(m => m.id !== placeholder.id);
        URL.revokeObjectURL(placeholder.src);
        updateStats();
        renderGrid();
        window.AppModal.alert('❌ Upload thất bại: ' + (err.message || 'Unknown error'), 'error');
      }
    });
  })();
}

// Initialize Date Filter
const dateSelect = document.getElementById('dateSelect');
if (dateSelect) {
  const uniqueDates = new Set();
  MEDIA_DATA.forEach(m => {
    const d = new Date(m.date);
    if (!isNaN(d.getTime())) {
      uniqueDates.add(`${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`);
    }
  });
  const sortedDates = Array.from(uniqueDates).sort().reverse();
  sortedDates.forEach(dateStr => {
    const [y, mStr] = dateStr.split('-');
    const option = document.createElement('option');
    option.value = dateStr;
    option.textContent = `Tháng ${mStr}, ${y}`;
    dateSelect.appendChild(option);
  });
}

// Attach functions to window so inline onclick can use them
window.handleSearch = handleSearch;
window.handleSort = handleSort;
window.handleDateFilter = handleDateFilter;
window.handleSeoFilter = handleSeoFilter;
window.handleTypeFilter = handleTypeFilter;
window.filterByType = filterByType;
window.changePage = changePage;
window.goToPage = goToPage;
window.toggleSelection = toggleSelection;
window.handleCardClick = handleCardClick;
window.deselectAll = deselectAll;
window.deleteSelected = deleteSelected;
window.deleteActive = deleteActive;
window.openDetail = openDetail;
window.closeDetail = closeDetail;
window.navigateImage = navigateImage;
window.triggerAutoSave = triggerAutoSave;
window.copyUrl = copyUrl;

// Initial stats sync and render first page
updateStats();
renderGrid();
</script>
</AdminLayout>

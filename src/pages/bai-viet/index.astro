---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';

export const prerender = false;

const db = (env as any)?.ladakh_d1;
let posts: any[] = [];
let categories: any[] = [];

const currentCatSlug = Astro.url.searchParams.get('chuyen-muc');

if (db) {
  try {
    const catRes = await db.prepare("SELECT * FROM BlogCategory ORDER BY name ASC").all();
    categories = catRes.results || [];

    let query = `
      SELECT p.*, c.name as categoryName, c.slug as categorySlug
      FROM Post p
      LEFT JOIN BlogCategory c ON p.categoryId = c.id
      WHERE p.status = 'published'
    `;
    const params: any[] = [];

    if (currentCatSlug) {
      query += ` AND c.slug = ?`;
      params.push(currentCatSlug);
    }

    query += ` ORDER BY p.createdAt DESC`;
    const postRes = await db.prepare(query).bind(...params).all();
    posts = postRes.results || [];
  } catch (e) {
    console.error('Error fetching blog data:', e);
  }
}

const currentCategory = categories.find(c => c.slug === currentCatSlug);
const pageTitle = currentCategory 
  ? `${currentCategory.name} - Cẩm Nang Du Lịch Ladakh` 
  : "Cẩm Nang & Kinh Nghiệm Du Lịch Ladakh Tự Túc";
const pageDesc = currentCategory?.description || "Tổng hợp bài viết hướng dẫn du lịch Ladakh thực tế: visa Ấn Độ, thuê xe Leh Taxi Union, lịch trình vượt đèo Khardung La và kinh nghiệm phòng tránh say độ cao AMS.";
---

<BaseLayout 
  title={pageTitle} 
  description={pageDesc}
  canonicalUrl={`https://dulichladakh.com/bai-viet${currentCatSlug ? `?chuyen-muc=${currentCatSlug}` : ''}`}
>
  <!-- HERO BANNER -->
  <section class="relative pt-32 pb-20 overflow-hidden bg-slate-950 border-b border-slate-800">
    <div class="absolute inset-0 opacity-20 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-amber-500/30 via-transparent to-transparent pointer-events-none"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-semibold mb-4">
        <span>🏔️</span>
        <span>Himalayan Travel Journal</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-4 max-w-3xl mx-auto">
        {currentCategory ? currentCategory.name : 'Cẩm Nang Du Lịch Ladakh Tự Túc'}
      </h1>
      <p class="text-sm sm:text-base text-slate-400 max-w-2xl mx-auto leading-relaxed">
        {pageDesc}
      </p>

      <!-- CATEGORY TABS -->
      <div class="flex flex-wrap items-center justify-center gap-2 mt-8">
        <a
          href="/bai-viet"
          class={`px-4 py-2 rounded-xl text-xs font-semibold transition-all ${
            !currentCatSlug 
              ? 'bg-amber-500 text-slate-950 font-bold shadow-md shadow-amber-500/20' 
              : 'bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:bg-slate-800'
          }`}
        >
          Tất Cả Bài Viết
        </a>
        {categories.map(cat => (
          <a
            href={`/bai-viet?chuyen-muc=${cat.slug}`}
            class={`px-4 py-2 rounded-xl text-xs font-semibold transition-all ${
              currentCatSlug === cat.slug 
                ? 'bg-amber-500 text-slate-950 font-bold shadow-md shadow-amber-500/20' 
                : 'bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:bg-slate-800'
            }`}
          >
            {cat.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- POSTS GRID -->
  <section class="py-16 bg-slate-900 min-h-[500px]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      {posts.length === 0 ? (
        <div class="p-16 text-center text-slate-500 bg-slate-950/60 rounded-3xl border border-slate-800">
          <p class="text-base font-semibold text-slate-400">Chưa có bài viết nào trong chuyên mục này</p>
          <p class="text-xs text-slate-500 mt-2">Chúng tôi đang biên tập các nội dung cẩm nang mới nhất.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map(post => (
            <article class="group bg-slate-950/70 border border-slate-800/80 rounded-2xl overflow-hidden hover:border-amber-500/40 transition-all duration-300 flex flex-col hover:-translate-y-1 shadow-lg hover:shadow-2xl hover:shadow-amber-500/5">
              <a href={`/bai-viet/${post.slug}`} class="block relative aspect-[16/10] overflow-hidden bg-slate-900">
                <img
                  src={post.featuredImage || 'https://media.dulichladakh.com/uploads/mountain-view-room-kashmir-himalaya.webp'}
                  alt={post.title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                {post.categoryName && (
                  <span class="absolute top-3 left-3 px-2.5 py-1 rounded-lg bg-slate-950/80 backdrop-blur-md text-[11px] font-bold text-amber-400 border border-slate-800">
                    {post.categoryName}
                  </span>
                )}
              </a>

              <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
                <div class="space-y-2.5">
                  <div class="flex items-center gap-3 text-[11px] text-slate-500">
                    <span>⏱ {post.readingTime || 5} phút đọc</span>
                    <span>•</span>
                    <span>{new Date(post.createdAt).toLocaleDateString('vi-VN')}</span>
                  </div>
                  <h2 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors line-clamp-2 leading-snug">
                    <a href={`/bai-viet/${post.slug}`}>{post.title}</a>
                  </h2>
                  <p class="text-xs text-slate-400 line-clamp-3 leading-relaxed">
                    {post.excerpt || 'Đọc chi tiết cẩm nang hướng dẫn du lịch Ladakh...'}
                  </p>
                </div>

                <div class="pt-4 border-t border-slate-800/60 flex items-center justify-between">
                  <span class="text-xs font-medium text-slate-400 flex items-center gap-1.5">
                    <span class="w-5 h-5 rounded-full bg-slate-800 text-amber-400 text-[10px] font-bold flex items-center justify-center">L</span>
                    <span>{post.author || 'FIT TOUR Curator'}</span>
                  </span>
                  <a
                    href={`/bai-viet/${post.slug}`}
                    class="text-xs font-bold text-amber-400 hover:text-amber-300 inline-flex items-center gap-1"
                  >
                    <span>Chi Tiết</span>
                    <span>→</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
